<form method="post" action="{{ path('app_prescription_delete', {'id': prescription.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette prescription {{ prescription.id }} ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ prescription.id) }}">
    {% if is_granted('ROLE_MEDECIN') %}
        <button type="submit" class="btn btn-outline-danger">Supprimer</button>
    {% endif %}
</form>
