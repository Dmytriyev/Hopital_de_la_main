{% extends 'base.html.twig' %}

{% block title %}Prescription{% endblock %}

{% block body %}
    <h1>Prescription</h1>
    {% if app.user is not null %}

        <table class="table">
            <tbody>
                <tr>
                    <th>Traitement</th>
                    <td>{{ prescription.traitement }}</td>
                </tr>
                <tr>
                    <th>Durée du Traitement</th>
                    <td>{{ prescription.dureeTraitement }}</td>
                </tr>
                <tr>
                    <th>Détails</th>
                    <td>{{ prescription.details }}</td>
                </tr>
                <tr>
                    <th>Créé le</th>
                    <td>{{ prescription.createdAt ? prescription.createdAt|date('d/m/Y H:i') : '' }}</td>
                </tr>
            </tbody>
        </table>

        <a type="button" class="btn btn-outline-primary" href="{{ path('app_prescription_index') }}">Retour à la liste</a>
        {% if is_granted('ROLE_MEDECIN') %}
            <a type="button" class="btn btn-outline-warning" href="{{ path('app_prescription_edit', {'id': prescription.id}) }}">Modifier</a>
        {% endif %}

        {{ include('prescription/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}
