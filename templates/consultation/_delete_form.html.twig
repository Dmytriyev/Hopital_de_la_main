<form method="post" action="{{ path('app_consultation_delete', {'id': consultation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette consultation {{ consultation.id }} ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ consultation.id) }}">
    {% if is_granted('ROLE_MEDECIN') %}
        <button class="btn btn-outline-danger" type="submit">Supprimer</button>
    {% endif %}
</form>
