{% extends 'base.html.twig' %}

{% block title %}Consultation
{% endblock %}

{% block body %}
	<h1>Consultation</h1>
	{% if app.user is not null %}

		<table class="table">
			<tbody>
				<tr>
					<th>Matricule</th>
					<td>{{ consultation.matricule }}</td>
				</tr>
				<tr>
					<th>Patient</th>
					<td>{{ consultation.patient ? consultation.patient.nom ~ ' ' ~ consultation.patient.prenom : '-' }}</td>
				</tr>
				<tr>
					<th>Compte Rendu</th>
					<td>{{ consultation.compteRendu }}</td>
				</tr>
				<tr>
					<th>Créé le</th>
					<td>{{ consultation.createdAt ? consultation.createdAt|date('d/m/Y H:i') : '' }}</td>
				</tr>
			</tbody>
		</table>

		<a type="button" class="btn btn-outline-primary" href="{{ path('app_consultation_index') }}">Retour à la liste</a>
		{% if is_granted('ROLE_MEDECIN') %}
			<a type="button" class="btn btn-outline-warning" href="{{ path('app_consultation_edit', {'id': consultation.id}) }}">Modifier</a>
		{% endif %}
		{{ include('consultation/_delete_form.html.twig') }}
	{% endif %}
{% endblock %}
