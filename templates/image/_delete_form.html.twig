<form method="post" action="{{ path('app_image_delete', {'id': image.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette image {{ image.fileName }} (ID: {{ image.id }}) ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ image.id) }}">
        {% if is_granted('ROLE_MEDECIN') %}
            <button type="submit" class="btn btn-outline-danger">Supprimer</button>
        {% endif %}
</form>
