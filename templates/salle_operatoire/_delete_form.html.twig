<form method="post" action="{{ path('app_salle_operatoire_delete', {'id': salle_operatoire.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette salle opératoire {{ salle_operatoire.numeroSalle }} ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ salle_operatoire.id) }}">
    {% if is_granted('ROLE_ADMIN') %}
        <button type="submit" class="btn btn-outline-danger">Supprimer</button>
    {% endif %}
</form>
