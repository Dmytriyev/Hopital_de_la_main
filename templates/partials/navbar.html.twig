<section>
	{% if app.user %}
		<a class="btn m-auto btn-outline-dark btn-primary" href="{{ path('app_home') }}">Accueil</a>
		<hr class="divider"/></hr>
		{% if is_granted("ROLE_MEDECIN") %}
			<a class="btn btn-outline-dark btn-primary" href="{{ path('app_dossier_patient_index') }}">Choisir un Dossier</a>
			<a class="btn btn-outline-dark btn-primary" href="{{ path('app_rdv_index') }}">Rendez-vous</a>
			<a class="btn btn-outline-dark btn-primary" href="{{ path('app_rdv_operatoire_index') }}">Rendez-vous opératoire</a>
			<a class="btn btn-outline-dark btn-primary" href="{{ path('app_consultation_index') }}">Consultations</a>
			<a class="btn btn-outline-dark btn-primary" href="{{ path('app_observation_index') }}">Observations</a>
		{% endif %}
		{% if is_granted("ROLE_SECRETAIRE") %}
			<a class="btn btn-outline-dark btn-primary" href="{{ path('app_dossier_patient_index') }}">Choisir un Dossier</a>
			<a class="btn btn-outline-dark btn-primary" href="{{ path('app_rdv_index') }}">Rendez-vous</a>
			<a class="btn btn-outline-dark btn-primary" href="{{ path('app_rdv_operatoire_index') }}">Rendez-vous opératoire</a>
			<a class="btn btn-outline-dark btn-primary" href="{{ path('app_user_index') }}">Équipe médicale</a>
		{% endif %}
		{% if is_granted("ROLE_INFERMIER") %}
			<a class="btn btn-outline-dark btn-primary" href="{{ path('app_dossier_patient_index') }}">Choisir un Dossier</a>
			<a class="btn btn-outline-dark btn-primary" href="{{ path('app_observation_index') }}">Observations</a>
		{% endif %}
		{% if is_granted("ROLE_DIRECTION") %}
			<a class="btn btn-outline-dark btn-primary" href="{{ path('app_user_index') }}">Équipe médicale</a>
			<a class="btn btn-outline-dark btn-primary" href="{{ path('app_rdv_index') }}">Rendez-vous</a>
		{% endif %}
		{% if is_granted("ROLE_ADMIN") %}
			<a class="btn btn-outline-dark btn-primary" href="{{ path('app_register') }}">Inscrire un membre de l'équipe</a>
			<a class="btn btn-outline-dark btn-primary" href="{{ path('app_user_index') }}">Équipe médicale</a>
			<a class="btn btn-outline-dark btn-primary" href="{{ path('app_specialite_index') }}">Spécialités Médicales</a>
		{% endif %}
		<hr class="divider"/></hr>
		{% if app.user %}
			<p id="nom_connect" class=" m-auto display-7 px-2 fw-bold text-secondary-emphasis">
				{{ app.user.nom|capitalize }}
				{{ app.user.prenom|capitalize }}</p>
		{% endif %}
		<hr class="divider"/></hr>
		<a class="btn btn-outline-dark btn-primary" href="{{ path('app_logout') }}">Déconnexion</a>
	{% else %}
		<a class="btn btn-outline-dark btn-primary" href="{{ path('app_login') }}">Connexion</a>
	{% endif %}
</section>
