{% extends 'base.html.twig' %}

{% block title %}Observation index{% endblock %}

{% block body %}
    <h1>Liste des Observations</h1>
    {% if app.user is not null %}
        {% if is_granted('ROLE_MEDECIN') or is_granted('ROLE_INFERMIER') %}
            <a type="button" class="btn btn-outline-success" href="{{ path('app_observation_new') }}">Créer une nouvelle observation</a>
        {% endif %}

        <table class="table">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Observation</th>
                    <th>Créé le</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for observation in observations %}
                    <tr>
                        <td>{{ observation.patient ? observation.patient.nom ~ ' ' ~ observation.patient.prenom : '-' }}</td>
                        <td>{{ observation.observation }}</td>
                        <td>{{ observation.createdAt ? observation.createdAt|date('d/m/Y H:i') : '' }}</td>
                        <td>
                            <a type="button" class="btn btn-outline-primary" href="{{ path('app_observation_show', {'id': observation.id}) }}">Voir</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">Aucun enregistrement trouvé</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

{% endblock %}
