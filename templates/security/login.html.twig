{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div id="login-container" class=" container mt-5">
<form method="post" action="{{ path('app_login') }}">
    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    {% if app.user %}
        <div class="mb-3">
            Vous êtes connecté en tant que {{ app.user.email }}, <a class="btn btn-outline-warning" href="{{ logout_path() }}">Se déconnecter</a>
        </div>
    {% endif %}
    <img id="gif" src="{{ asset('Image/Gif_Hôpital_de_la_Main.gif') }}" height="150" alt="Logo"/>
    <h1 class="h3 mb-3 font-weight-normal">Veuillez vous connecter</h1>
    <label for="inputEmail">Email</label>
    <input type="email" value="{{ email }}" name="email" id="inputEmail" class="form-control mb-2" required autofocus>
    <label for="inputPassword">Mot de passe</label>
    <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

    <button class="btn btn-lg btn-primary mt-3" type="submit">
        Se connecter
    </button>
</form>
</div>
{% endblock %}
