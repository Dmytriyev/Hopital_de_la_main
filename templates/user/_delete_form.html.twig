<form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur {{ user.nom }} {{ user.prenom }} ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    {% if is_granted('ROLE_ADMIN') %}
        <button class="btn btn-outline-danger" type="submit">Supprimer</button>
    {% endif %}
</form>
