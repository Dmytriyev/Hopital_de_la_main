<form method="post" action="{{ path('app_chambre_delete', {'id': chambre.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette chambre {{ chambre.numeroChambre }} ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ chambre.id) }}">
    {% if is_granted('ROLE_ADMIN') %}
        <button class="btn" type="submit" class="btn btn-outline-danger">Supprimer</button>
    {% endif %}
</form>
